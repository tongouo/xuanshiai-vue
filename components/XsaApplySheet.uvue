<template>
	<XsaSheet :visible="visible" title="申请认识" :tall="false" theme="lilac" @close="handleClose">
		<view class="apply-sheet">
			<text class="lead">对方同意后才能开始聊天。请用具体、尊重的话说明你为什么想认识 TA。</text>
			<view class="meta-row">
				<text class="meta-label">今日剩余免费次数</text>
				<text class="meta-value">{{ remainText }}</text>
			</view>
			<textarea
				class="message-input"
				:value="message"
				@input="onInput"
				placeholder="例如：看到你也喜欢看展，想认真了解一下…"
				placeholder-style="color: #B3AFCB"
				maxlength="120"
			></textarea>
			<text class="count">{{ message.length }}/120</text>
			<view class="actions">
				<button class="btn secondary" @click="handleClose">取消</button>
				<button class="btn primary" :disabled="submitting || message.trim().length == 0" @click="handleSubmit">
					{{ submitting ? '提交中…' : '发送申请' }}
				</button>
			</view>
		</view>
	</XsaSheet>
</template>

<script setup lang="uts">
	import XsaSheet from '@/components/XsaSheet.uvue'
	import { applyToMeet, getCommunityQuotas } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	interface Props {
		visible: boolean
		userId: number
	}

	const props = withDefaults(defineProps<Props>(), {
		visible: false,
		userId: 0
	})

	const emit = defineEmits<{
		close: []
		success: [payload: any]
	}>()

	const message = ref('')
	const submitting = ref(false)
	const remain = ref(2)

	watch(
		() => props.visible,
		async (v: boolean) => {
			if (v) {
				message.value = ''
				try {
					const res = await getCommunityQuotas()
					if (res.success && res.data != null && res.data.applyDaily != null) {
						remain.value = res.data.applyDaily.remain
					}
				} catch (e) {
					console.error(e)
				}
			}
		}
	)

	const remainText = computed(() => {
		return remain.value + ' 次'
	})

	const onInput = (e: any) => {
		message.value = e.detail.value
	}

	const handleClose = () => {
		emit('close')
	}

	const handleSubmit = async () => {
		if (submitting.value) return
		const text = message.value.trim()
		if (text.length == 0) {
			uni.showToast({ title: '请填写申请附言', icon: 'none' })
			return
		}
		const ok = await guardRealName('apply')
		if (!ok) return
		if (remain.value <= 0) {
			uni.showToast({ title: '今日免费次数已用完，可用积分加次', icon: 'none' })
			return
		}
		submitting.value = true
		try {
			const res = await applyToMeet(props.userId, text)
			// 仅 data.success===true 视为成功；409 等为 failRes
			const data = res != null ? res.data : null
			const bizOk =
				res != null && res.success == true && data != null && data.success == true
			if (bizOk) {
				if (data.remain != null) {
					remain.value = data.remain
				}
				// remain==null 禁止本地 remain-1
				const toastTitle =
					data.quotaRefreshFailed == true
						? '申请已发送，额度同步失败请下拉刷新'
						: '申请已发送'
				uni.showToast({ title: toastTitle, icon: data.quotaRefreshFailed == true ? 'none' : 'success' })
				emit('success', data)
				emit('close')
			} else {
				const msg =
					data != null && data.message != null
						? data.message
						: res != null && res.message != null
							? res.message
							: '发送失败，请重试'
				uni.showToast({ title: msg, icon: 'none' })
				if (data != null && data.remain != null) {
					remain.value = data.remain
				}
			}
		} catch (e) {
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			submitting.value = false
		}
	}
</script>

<style scoped>
	.apply-sheet {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.lead {
		font-size: 16px;
		line-height: 1.6;
		color: #5A566B;
	}

	.meta-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 10px 12px;
		background: #F6F6FE;
		border-radius: 10px;
	}

	.meta-label {
		font-size: 18px;
		color: #7B79F2;
	}

	.meta-value {
		font-size: 13px;
		font-weight: 700;
		color: #7B79F2;
	}

	.message-input {
		width: 100%;
		min-height: 140px;
		padding: 12px;
		background: #FFFFFF;
		border: 1px solid #BDB9F6;
		border-radius: 12px;
		font-size: 14px;
		color: #3E3A4D;
		line-height: 1.55;
	}

	.count {
		align-self: flex-end;
		font-size: 11px;
		color: #9A96AD;
	}

	.actions {
		display: flex;
		flex-direction: row;
		gap: 10px;
		margin-top: 6px;
		padding-bottom: 8px;
	}

	.btn {
		flex: 1;
		height: 44px;
		border-radius: 999px;
		font-size: 20px;
		font-weight: 600;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border: none;
	}

	.btn.secondary {
		background: #FFFFFF;
		color: #6E6A85;
		border: 1px solid #BDB9F6;
	}

	.btn.primary {
		background: #7F7DF8;
		color: #FFFFFF;
	}

	.btn[disabled] {
		opacity: 0.5;
	}
</style>
