<template>
	<XsaSheet :visible="visible" title="举报与屏蔽" title-sans close-up :large-text="largeText" @close="handleClose">
		<view class="report-sheet" :class="{ 'large-text': largeText }">
			<text class="lead">举报与屏蔽提交后我们会尽快核查处理，你的举报身份严格保密，不会向对方泄露。</text>

			<text class="section-title">举报原因</text>
			<view class="reason-list">
				<view
					class="reason-item"
					:class="{ active: reasonId == item.id }"
					v-for="item in reasons"
					:key="item.id"
					@click="reasonId = item.id"
				>
					<text>{{ item.label }}</text>
				</view>
			</view>

			<textarea
				class="detail-input"
				:value="detail"
				@input="onDetailInput"
				placeholder="补充说明（可选）"
				maxlength="200"
			></textarea>

			<view class="actions">
				<button class="btn secondary" @click="handleBlock">屏蔽该用户</button>
				<button class="btn primary" :disabled="submitting || reasonId == ''" @click="handleReport">
					{{ submitting ? '提交中…' : '提交举报' }}
				</button>
			</view>
		</view>
	</XsaSheet>
</template>

<script setup lang="uts">
	import XsaSheet from '@/components/XsaSheet.uvue'
	import type { ParentContext } from '@/api'
	import {
		blockParentCandidate,
		blockUser,
		getReportReasons,
		reportContent,
		reportParentCandidate
	} from '@/api'

	interface Props {
		visible: boolean
		targetType: string
		targetId: number
		userId: number
		largeText?: boolean
		parentMode?: boolean
		parentContext?: ParentContext | null
	}

	const props = withDefaults(defineProps<Props>(), {
		visible: false,
		targetType: 'post',
		targetId: 0,
		userId: 0,
		largeText: false,
		parentMode: false,
		parentContext: null
	})

	const emit = defineEmits<{
		close: []
		reported: []
		blocked: [userId: number]
	}>()

	const reasons = ref([
		{ id: 'harass', label: '骚扰或不适内容' },
		{ id: 'fake', label: '虚假资料或冒充' },
		{ id: 'ad', label: '广告或引流' },
		{ id: 'other', label: '其他安全问题' }
	])
	const reasonId = ref('')
	const detail = ref('')
	const submitting = ref(false)

	watch(
		() => props.visible,
		async (v: boolean) => {
			if (v) {
				reasonId.value = ''
				detail.value = ''
				try {
					const res = await getReportReasons()
					if (res.success && res.data != null) {
						reasons.value = res.data as any[]
					}
				} catch (e) {
					console.error(e)
				}
			}
		}
	)

	const onDetailInput = (e: any) => {
		detail.value = e.detail.value
	}

	const handleClose = () => {
		emit('close')
	}

	const handleReport = async () => {
		if (submitting.value || reasonId.value == '') return
		// 内容举报：targetType + targetId；用户举报：userId
		let type = props.targetType != null && props.targetType != '' ? props.targetType : 'user'
		if (type == 'paperPlane') {
			type = 'paper_plane'
		}
		const isContent = type == 'post' || type == 'comment' || type == 'paper_plane'
		let reportId = 0
		if (isContent) {
			reportId = props.targetId
			if (reportId <= 0) {
				uni.showToast({ title: '无法举报：缺少内容信息', icon: 'none' })
				return
			}
		} else {
			reportId = props.userId
			if (reportId <= 0) {
				uni.showToast({ title: '无法举报：缺少用户信息', icon: 'none' })
				return
			}
				type = 'user'
			}
			if (props.parentMode && props.parentContext == null) {
				uni.showToast({ title: '暂时无法确认父母身份，请重试', icon: 'none' })
				return
			}
			submitting.value = true
			try {
				const reportDetail = detail.value != null ? detail.value : ''
				const res = props.parentMode
					? await reportParentCandidate(
						props.parentContext,
						reportId,
						reasonId.value,
						reportDetail
					)
					: await reportContent(type, reportId, reasonId.value, reportDetail)
				if (res.success) {
					uni.showToast({ title: '举报已提交', icon: 'success' })
				emit('reported')
				emit('close')
			} else {
				const msg =
					res.data != null && res.data.message != null
						? res.data.message
						: res.message != null
							? res.message
							: '提交失败'
				uni.showToast({ title: msg, icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '网络异常', icon: 'none' })
		} finally {
			submitting.value = false
		}
	}

	const handleBlock = async () => {
		if (props.userId <= 0) {
			uni.showToast({ title: '无法屏蔽', icon: 'none' })
			return
		}
		uni.showModal({
			title: '确认屏蔽',
			content: '屏蔽后将不再看到该用户内容，可在设置中管理。',
			confirmText: '屏蔽',
			success: async (res) => {
				if (!res.confirm) return
				if (props.parentMode && props.parentContext == null) {
					uni.showToast({ title: '暂时无法确认父母身份，请重试', icon: 'none' })
					return
				}
				try {
					const r = props.parentMode
						? await blockParentCandidate(props.parentContext, props.userId)
						: await blockUser(props.userId)
					if (r.success) {
						uni.showToast({ title: '已屏蔽', icon: 'success' })
						emit('blocked', props.userId)
						emit('close')
					} else {
						const msg =
							r.data != null && r.data.message != null
								? r.data.message
								: r.message != null
									? r.message
									: '屏蔽失败，请重试'
						uni.showToast({ title: msg, icon: 'none' })
					}
				} catch (e) {
					uni.showToast({ title: '操作失败', icon: 'none' })
				}
			}
		})
	}
</script>

<style scoped>
	.report-sheet {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-family: var(--sans);
	}

	.lead {
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
		padding-left: 9px;
		font-family: var(--sans);
	}

	.section-title {
		font-size: 15px;
		font-weight: 700;
		color: var(--ink);
		padding-left: 9px;
		font-family: var(--sans);
	}

	.reason-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.reason-item {
		padding: 12px 14px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
		font-size: 15px;
		color: var(--ink);
		font-family: var(--sans);
	}

	.reason-item.active {
		border-color: var(--accent);
		background: var(--accent-bg);
		color: var(--accent);
		font-weight: 400;
	}

	.detail-input {
		width: 100%;
		min-height: 72px;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
		font-size: 14px;
		color: var(--ink);
		font-family: var(--sans);
	}

	.actions {
		display: flex;
		flex-direction: row;
		gap: 10px;
		margin-top: 4px;
	}

	.btn {
		flex: 1;
		height: 44px;
		border-radius: 999px;
		font-size: 18px;
		font-weight: 600;
		border: none;
		margin: 0;
		padding: 3px 0 0 0;
		box-sizing: border-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		font-family: var(--sans);
	}

	.btn.secondary {
		background: var(--paper);
		color: var(--ink);
		border: 1px solid var(--line);
	}

	.btn.primary {
		background: var(--accent);
		color: var(--text-invert);
	}

	.report-sheet.large-text .lead {
		font-size: 18px;
	}

	.report-sheet.large-text .section-title,
	.report-sheet.large-text .reason-item,
	.report-sheet.large-text .detail-input,
	.report-sheet.large-text .btn {
		font-size: 20px;
	}

	.report-sheet.large-text .reason-item {
		min-height: 48px;
		display: flex;
		align-items: center;
	}

	.report-sheet.large-text .detail-input {
		min-height: 112px;
	}

	.report-sheet.large-text .btn {
		height: auto;
		min-height: 48px;
		border-radius: 8px;
	}

	.btn[disabled] {
		opacity: 0.5;
	}
</style>
