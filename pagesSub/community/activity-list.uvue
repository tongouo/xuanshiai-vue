<template>
	<view class="page">
		<view class="toolbar">
			<view class="chip" :class="{ active: filter == 'all' }" @click="setFilter('all')"><text>全部</text></view>
			<view class="chip" :class="{ active: filter == 'recruiting' }" @click="setFilter('recruiting')"><text>招募中</text></view>
			<text class="mine text-accent" @click="goMine">我的活动</text>
		</view>
		<scroll-view class="list" scroll-y>
			<XsaEmpty v-if="!loading && list.length == 0" text="暂无活动" description="线下活动会在这里发布" />
			<view class="card" v-for="a in list" :key="a.id" @click="open(a.id)">
				<image class="cover" :src="a.cover" mode="aspectFill"></image>
				<view class="body">
					<text class="kicker">{{ a.kicker }}</text>
					<text class="title">{{ a.title }}</text>
					<text class="desc text-muted">{{ a.description }}</text>
					<view class="meta-row">
						<text class="meta text-muted">{{ a.date }} {{ a.time }}</text>
						<text class="price" v-if="a.price > 0">¥{{ a.price }}</text>
						<text class="price free" v-else>免费</text>
					</view>
					<text class="seat text-muted">{{ a.participantCount }}/{{ a.maxParticipants }} 人 · 需实名</text>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import { getActivities } from '@/api'

	const filter = ref('all')
	const loading = ref(false)
	const list = ref([])

	onMounted(() => {
		load()
	})

	const load = async () => {
		loading.value = true
		try {
			const res = await getActivities(filter.value)
			if (res.success) list.value = res.data as any[]
		} catch (e) {
			console.error(e)
		} finally {
			loading.value = false
		}
	}

	const setFilter = async (f: string) => {
		filter.value = f
		await load()
	}

	const open = (id: number) => {
		uni.navigateTo({ url: `/pagesSub/community/activity-detail?id=${id}` })
	}

	const goMine = () => {
		uni.navigateTo({ url: '/pagesSub/community/my-activities' })
	}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}
	.toolbar {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		padding: 12px 14px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.chip {
		height: 30px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--line);
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.chip text {
		font-size: 12px;
		color: var(--muted);
	}
	.chip.active {
		border-color: var(--accent);
		background: var(--soft);
	}
	.chip.active text {
		color: var(--accent);
		font-weight: 700;
	}
	.mine {
		margin-left: auto;
		font-size: 12px;
		font-weight: 700;
	}
	.list {
		flex: 1;
		height: 0;
		padding: 12px 14px;
	}
	.card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 12px;
	}
	.cover {
		width: 100%;
		height: 140px;
	}
	.body {
		padding: 12px 14px 14px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.kicker {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--accent);
	}
	.title {
		font-size: 18px;
		font-family: var(--sans);
		font-weight: 700;
		color: var(--ink);
	}
	.desc {
		font-size: 12px;
		line-height: 1.5;
	}
	.meta-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
	}
	.meta {
		font-size: 12px;
	}
	.price {
		margin-left: auto;
		font-size: 13px;
		font-weight: 800;
		color: var(--brown);
	}
	.price.free {
		color: var(--sage);
	}
	.seat {
		font-size: 11px;
	}
	.pad {
		height: 24px;
	}
</style>
