/* ===== 生成层 ===== */
.at-curing-overlay {
	position: fixed; inset: 0; z-index: 90;
	background: rgba(36, 27, 18, 0.94);
	display: flex; flex-direction: column; align-items: center; justify-content: center;
	padding: 40px 30px;
}
.at-curing-overlay-body { display: flex; flex-direction: column; align-items: center; }
.at-curing-steam-lg .at-steam-dot { width: 14px; height: 14px; }
.at-curing-overlay-title { font-size: 19px; font-weight: 700; color: #F6EEE0; font-family: var(--serif); margin-top: 18px; }
.at-curing-lines { display: flex; flex-direction: column; align-items: flex-start; margin-top: 24px; gap: 10px; }
.at-cure-line { display: flex; flex-direction: row; align-items: center; gap: 9px; }
.at-cure-check { font-size: 13px; color: #E8B54F; font-weight: 700; }
.at-cure-line-text { font-size: 13px; color: rgba(246, 238, 224, 0.85); }
